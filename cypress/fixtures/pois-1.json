{"type":"FeatureCollection","features":[{"type":"Feature","properties":{"ele":310,"name":{"it":"Parco Archeologico di Luine"},"layers":[102],"description":{"de":null,"it":"<p dir=\"ltr\" style=\"text-align: left;\"><span style=\"color: rgb(34, 34, 34); background-color: transparent;\">Uno dei repertori rupestri più ricchi della Valle Camonica, con incisioni che coprono un arco temporale dal Paleolitico all'Età del Bronzo. La roccia 34 è considerata la \"superficie-leader\" dell'intero sito per ampiezza e varietà; la roccia 6 conta centinaia di figure diverse.</span></p>"},"addr_complete":null,"addr_locality":null,"contact_email":null,"contact_phone":null,"opening_hours":null,"taxonomy_where":{"R44879":{"de":"Lombardei","en":"Lombardy","es":"Lombardía","fr":"Lombardie","it":"Lombardia","_admin_level":4},"R46364":{"en":"Darfo Boario Terme","it":"Darfo Boario Terme","_admin_level":8}},"addr_housenumber":null,"id":425,"taxonomy":{"activity":[],"when":[],"poi_type":{"id":249,"name":{"it":"Arte e Cultura","en":"Art and Culture"},"description":[],"identifier":"arte-cultura","icon_name":"txn-castle"},"poi_types":[{"id":249,"name":{"it":"Arte e Cultura","en":"Art and Culture"},"description":[],"identifier":"arte-cultura","icon_name":"txn-castle"}]},"taxonomyWheres":["Lombardia","Darfo Boario Terme"],"created_at":"2026-06-23T14:05:48.000000Z","updated_at":"2026-06-30T07:21:02.000000Z","taxonomyIdentifiers":["poi_type_arte-cultura"],"related":false},"geometry":{"type":"Point","coordinates":[10.178496552,45.89116326,0]}},{"type":"Feature","properties":{"ele":578,"name":{"it":"Fontanella in Largo battaglione Manni"},"layers":[24],"addr_complete":null,"addr_locality":null,"contact_email":null,"contact_phone":null,"opening_hours":null,"taxonomy_where":{"R42004":{"de":"Umbrien","en":"Umbria","es":"Umbría","fr":"Ombrie","it":"Umbria","_admin_level":4},"R42064":{"it":"Terni","_admin_level":8}},"addr_housenumber":null,"id":396,"taxonomy":{"activity":[],"when":[],"poi_type":{"id":92,"name":{"it":"Punto Acqua","en":"Drinking water","de":null},"description":{"de":null},"identifier":"fountain","icon_name":"txn-water"},"poi_types":[{"id":92,"name":{"it":"Punto Acqua","en":"Drinking water","de":null},"description":{"de":null},"identifier":"fountain","icon_name":"txn-water"}]},"taxonomyWheres":["Umbria","Terni"],"created_at":"2026-06-19T09:27:33.000000Z","updated_at":"2026-06-30T07:21:02.000000Z","taxonomyIdentifiers":["poi_type_fountain"],"related":false},"geometry":{"type":"Point","coordinates":[12.686455,42.533752,0]}},{"type":"Feature","properties":{"ele":419,"name":{"it":"Ex Ferrovia Spoleto"},"layers":[130],"description":{"de":null,"it":"<p style=\"text-align: left;\"><span style=\"color: rgb(0, 0, 0); background-color: transparent;\">Nell’ultimo tratto del cammino si intercetta nuovamente la spettacolare</span><a target=\"_blank\" href=\"https://maps.google.com/?cid=12877637850335783360&amp;g_mp=Cidnb29nbGUubWFwcy5wbGFjZXMudjEuUGxhY2VzLlNlYXJjaFRleHQ\" tt-mode=\"url\"><span style=\"color: rgb(0, 0, 0); background-color: transparent;\"> </span><span style=\"color: rgb(17, 85, 204); background-color: transparent;\"><strong><u>Ex Ferrovia Spoleto - Norcia</u></strong></span></a><span style=\"color: rgb(0, 0, 0); background-color: transparent;\">. Questo segmento finale offre un'esperienza indimenticabile: si cammina attraverso alcune suggestive e storiche gallerie scavate nella roccia e si attraversa un imponente ponte viadotto. Proprio dall'alto di questo viadotto si apre un panorama eccezionale sulla Valle Spoletina: guardando all'indietro, lo sguardo riesce a spaziare lungo la costa della collina fino a scorgere nettamente, adagiata sul colle opposto, la città di <strong>Trevi</strong>, permettendo di abbracciare visivamente il punto di partenza dell’ultima tappa.</span></p>"},"addr_complete":null,"addr_locality":null,"contact_email":null,"contact_phone":null,"opening_hours":null,"taxonomy_where":{"R42004":{"de":"Umbrien","en":"Umbria","es":"Umbría","fr":"Ombrie","it":"Umbria","_admin_level":4},"R42105":{"en":"Spoleto","it":"Spoleto","_admin_level":8}},"addr_housenumber":null,"id":395,"taxonomy":{"activity":[],"when":[],"poi_type":{"id":293,"name":{"it":"Ferrovia"},"description":[],"identifier":"railway","icon_name":"txn-rail"},"poi_types":[{"id":293,"name":{"it":"Ferrovia"},"description":[],"identifier":"railway","icon_name":"txn-rail"}]},"taxonomyWheres":["Umbria","Spoleto"],"created_at":"2026-06-17T10:32:06.000000Z","updated_at":"2026-06-30T07:21:02.000000Z","taxonomyIdentifiers":["poi_type_railway"],"related":false},"geometry":{"type":"Point","coordinates":[12.765061521,42.746901118,0]}},{"type":"Feature","properties":{"ele":364,"name":{"it":"Bazzano Inferiore"},"layers":[130],"description":{"de":null,"it":"<p style=\"text-align: left;\"><span style=\"color: rgb(0, 0, 0); background-color: transparent;\">Lungo questa parte di cammino, coincidente con&nbsp; parte del <strong>Sentiero degli Olivi,</strong> si incontrano i due piccoli abitati di <strong>Poreta</strong> e <strong>Bazzano Inferiore</strong>, frazioni storiche del Comune di Spoleto, nate come insediamenti di mezza costa ai piedi delle rispettive fortificazioni medievali.</span></p>"},"addr_complete":null,"addr_locality":null,"contact_email":null,"contact_phone":null,"opening_hours":null,"taxonomy_where":{"R42004":{"de":"Umbrien","en":"Umbria","es":"Umbría","fr":"Ombrie","it":"Umbria","_admin_level":4},"R42105":{"en":"Spoleto","it":"Spoleto","_admin_level":8}},"addr_housenumber":null,"id":393,"taxonomy":{"activity":[],"when":[],"poi_type":{"id":331,"name":{"it":"Frazioni","en":"hamlets"},"description":[],"identifier":"hamlet","icon_name":"txn-town"},"poi_types":[{"id":331,"name":{"it":"Frazioni","en":"hamlets"},"description":[],"identifier":"hamlet","icon_name":"txn-town"}]},"taxonomyWheres":["Umbria","Spoleto"],"created_at":"2026-06-17T10:24:44.000000Z","updated_at":"2026-06-30T07:21:02.000000Z","taxonomyIdentifiers":["poi_type_hamlet"],"rel